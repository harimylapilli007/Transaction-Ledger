# Any PostgreSQL database. Copy this file to .env and fill it in. Never commit .env.
#
# Local Postgres (see docker-compose.yml):
DATABASE_URL=postgresql://ledger:ledger@localhost:5432/ledger
#
# Supabase: Connect -> Session pooler. URL-encode special characters in the password (@ -> %40).
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Optional: put all tables in this Postgres schema instead of "public".
# DB_SCHEMA=ledger

PORT=8000
